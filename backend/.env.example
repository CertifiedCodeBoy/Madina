APP_NAME=Madina Smart City API
DEBUG=true

# PostgreSQL + PostGIS
DATABASE_URL=postgresql+asyncpg://madina:madina@localhost:5432/madina_db
DATABASE_SYNC_URL=postgresql://madina:madina@localhost:5432/madina_db

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenWeatherMap AQI
AQI_API_KEY=your_openweathermap_key_here

# Mapbox
MAPBOX_TOKEN=your_mapbox_token_here

# Firebase (optional push notifications)
FIREBASE_CREDENTIALS_PATH=

# GTFS-Realtime feed URL (leave empty to use mock data)
TRANSIT_GTFS_REALTIME_URL=

# AI model paths
IMAGE_MODEL_PATH=ai/image_classifier/mobilenet_v3_issue.tflite
NLP_FINE_TUNED_PATH=ai/nlp_assistant/fine_tuned
